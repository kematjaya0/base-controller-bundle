<div class="modal-content" id="modal-dialog">
    
    {% block form_start %}{% endblock %}
    
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title">{% block title %}{% endblock %}</h4>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-lg-12">
                <div id="message" class="hidden alert alert-danger"></div>
                
                {% block content %}{% endblock %}
            </div>
        </div>
        
    </div>
    <div class="modal-footer">
        
        {% block actions %}{% endblock %}
        
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fa fa-close"></i> {{ 'close'|trans }}</button>
        
    </div>
    
    {% block form_end %}{% endblock %}

<script src="{{asset('bundles/basecontroller/js/jquery.form.js')}}" type="text/javascript"></script>
<script>
    $(document).ready(function () {
        // Only http(s) and relative URLs are ever handed to the browser.
        // .attr("href") prevents attribute-breakout injection, but it does NOT
        // stop a "javascript:" or "data:" URL from executing when the link is
        // clicked, nor window.location from running script directly.
        function safeRedirectUrl(raw) {
            if (typeof raw !== 'string') {
                return null;
            }
            // Browsers ignore leading whitespace and strip tab/newline/CR
            // while resolving a URL, so "java\tscript:" would otherwise pass a
            // naive scheme test. Decide on a normalised copy, but hand back
            // the original string so legitimate URLs are not mangled.
            var probe = raw.replace(/[\u0000-\u0020]/g, '');
            if (probe === '') {
                return null;
            }
            // No scheme at all: relative path, query or fragment - safe.
            if (!/^[a-zA-Z][a-zA-Z0-9+.\-]*:/.test(probe)) {
                return raw;
            }
            // A scheme is present: allow only http and https.
            return /^https?:\/\//i.test(probe) ? raw : null;
        }

        var submitBtn = $("#ajaxForm").closest('form').find(':submit');
        $("#ajaxForm").ajaxForm({
            url: $(this).attr("action"), 
            type: 'post',
            dataType:  'json',
            beforeSubmit: function () {
                $("#message").removeClass("hidden alert-danger alert-info");
                $("#message").html('<p>&nbsp;&nbsp; <img src="{{ asset('bundles/basecontroller/images/loading.gif') }}" style="width: 20px"/> {{'send_data'|trans}} ... </p>');
                $("#message").addClass("alert alert-warning");
                submitBtn.addClass("disabled");
                submitBtn.attr("type", "button");
                $("#additional_actions").html("");
                submitBtn.html('<span class="fa fa-send"></span> {{'send_data'|trans}}');
            },
            success: function (e) {
                if (false === e.status) {
                    // The server error message is untrusted input, so it is
                    // inserted with .text() instead of being concatenated into
                    // markup passed to .html().
                    $("#message").html('<p>{{'error'|trans}}: <span class="error-text"></span></p>');
                    $("#message").find(".error-text").text(e.errors);
                    $("#message").removeClass("hidden");
                    submitBtn.removeClass("disabled");
                    submitBtn.attr("type", "submit");
                    submitBtn.html('<span class="fa fa-save"></span> {{'save'|trans}}');
                } else {
                    $("#message").html("<p>{{'successfull'|trans}}</p>");
                    $("#message").removeClass("hidden");
                    $("#message").removeClass("alert-danger alert-warning");
                    $("#message").addClass("alert-info");
                    if (e.redirectURL) {
                        if (e.redirectURL.length >1) {
                            for (i = 0; i < e.redirectURL.length; i++) {
                                let uri = e.redirectURL[i];
                                // Built through the DOM API instead of string
                                // concatenation: the url goes through .attr()
                                // and the title through a text node, so neither
                                // can inject markup. The url is additionally
                                // scheme-checked, because .attr("href") alone
                                // does not stop a "javascript:" URL from
                                // running when the link is clicked.
                                // uri.icon deliberately stays raw HTML: it is
                                // server-rendered and must never interpolate
                                // user-controlled values.
                                let url = safeRedirectUrl(uri.url);
                                if (url === null) {
                                    continue;
                                }
                                let $link = $('<a target="_blank" class="btn btn-primary"></a>').attr('href', url);
                                $link.append(uri.icon ? uri.icon : '<i class="fa fa-list"></i>');
                                $link.append(document.createTextNode(' ' + (uri.title || '')));
                                $("#additional_actions").append($link);
                            }

                            submitBtn.addClass("hidden");
                            submitBtn.attr("type", "submit");
                            submitBtn.html('<span class="fa fa-save"></span> {{'save'|trans}}');
                            $("#btn-modal-close").attr("onclick", "return location.reload();");
                        } else {
                            for (i = 0; i < e.redirectURL.length; i++) {
                                let url = safeRedirectUrl(e.redirectURL[i].url);
                                if (url !== null) {
                                    window.location = url;
                                }
                            }
                            
                        }
                    } else {
                        location.reload();
                    }
                }
            },
            error: function(xhr, status, error) {
                switch (xhr.status) {
                    case 500:
                        alert('500 status code! internal server error, please contact administrator.');
                        break;
                    case 302:
                        alert('session expire, please login.');
                        location.reload();
                        break;
                    default:
                        alert(xhr.responseText);
                        location.reload();
                        break;
                }
                
                $("#message").addClass("hidden");
                submitBtn.removeClass("disabled");
                submitBtn.attr("type", "submit");
                submitBtn.html('<span class="fa fa-save"></span> {{'save'|trans}}');
            }
        });
    });
</script>

    {% block javascripts %}{% endblock %}
    
</div>